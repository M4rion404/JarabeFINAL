// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum TransactionType {
  DEPOSIT
  TRANSFER
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  accounts  Account[]
}

model Account {
  id        String   @id @default(uuid())
  balance   Decimal  @default(0)
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id])
  outgoing  Transaction[] @relation("OutgoingTransactions")
  incoming  Transaction[] @relation("IncomingTransactions")
}

model Transaction {
  id            String           @id @default(uuid())
  amount        Decimal
  type          TransactionType
  createdAt     DateTime         @default(now())

  fromAccountId String?
  toAccountId   String?

  fromAccount   Account? @relation("OutgoingTransactions", fields: [fromAccountId], references: [id])
  toAccount     Account? @relation("IncomingTransactions", fields: [toAccountId], references: [id])
}
